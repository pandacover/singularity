diff --git a/packages/excalidraw/actions/actionTogglePresenterMode.tsx b/packages/excalidraw/actions/actionTogglePresenterMode.tsx
new file mode 100644
index 00000000..5bc12a66
--- /dev/null
+++ b/packages/excalidraw/actions/actionTogglePresenterMode.tsx
@@ -0,0 +1,27 @@
+import { CODES, KEYS } from "@excalidraw/common";
+
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { register } from "./register";
+
+export const actionTogglePresenterMode = register({
+  name: "presenterMode",
+  label: "labels.presenterMode",
+  viewMode: false,
+  trackEvent: {
+    category: "canvas",
+    predicate: (appState) => !appState.presenterModeEnabled,
+  },
+  perform(elements, appState) {
+    return {
+      appState: {
+        ...appState,
+        presenterModeEnabled: !this.checked!(appState),
+      },
+      captureUpdate: CaptureUpdateAction.NEVER,
+    };
+  },
+  checked: (appState) => appState.presenterModeEnabled,
+  keyTest: (event) =>
+    !event[KEYS.CTRL_OR_CMD] && event.altKey && event.code === CODES.J,
+});
