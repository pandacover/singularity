diff --git a/packages/excalidraw/actions/actionToggleRulers.tsx b/packages/excalidraw/actions/actionToggleRulers.tsx
new file mode 100644
index 00000000..aa462632
--- /dev/null
+++ b/packages/excalidraw/actions/actionToggleRulers.tsx
@@ -0,0 +1,27 @@
+import { CODES, KEYS } from "@excalidraw/common";
+
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { register } from "./register";
+
+export const actionToggleRulers = register({
+  name: "rulers",
+  label: "labels.rulers",
+  viewMode: true,
+  trackEvent: {
+    category: "canvas",
+    predicate: (appState) => !appState.rulersEnabled,
+  },
+  perform(elements, appState) {
+    return {
+      appState: {
+        ...appState,
+        rulersEnabled: !this.checked!(appState),
+      },
+      captureUpdate: CaptureUpdateAction.NEVER,
+    };
+  },
+  checked: (appState) => appState.rulersEnabled,
+  keyTest: (event) =>
+    !event[KEYS.CTRL_OR_CMD] && event.altKey && event.code === CODES.U,
+});
