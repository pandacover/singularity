{
  "name": "singularity",
  "version": "0.2.0",
  "private": true,
  "description": "Procedural memory graphs for coding agents",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "cli": "node apps/cli/src/cli.ts"
  },
  "devDependencies": {
    "turbo": "2.11.7"
  }
}
