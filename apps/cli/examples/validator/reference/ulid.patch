new file mode 100644
index 0000000..2ace6f4
--- /dev/null
+++ b/src/lib/isULID.js
@@ -0,0 +1,6 @@
+import assertString from './util/assertString';
+
+export default function isULID(str) {
+  assertString(str);
+  return /^[0-7][0-9A-HJKMNP-TV-Z]{25}$/i.test(str);
+}
