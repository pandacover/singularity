diff --git a/packages/excalidraw/actions/actionToggleMinimap.tsx b/packages/excalidraw/actions/actionToggleMinimap.tsx
new file mode 100644
index 00000000..80a47543
--- /dev/null
+++ b/packages/excalidraw/actions/actionToggleMinimap.tsx
@@ -0,0 +1,27 @@
+import { CODES, KEYS } from "@excalidraw/common";
+
+import { CaptureUpdateAction } from "@excalidraw/element";
+
+import { register } from "./register";
+
+export const actionToggleMinimap = register({
+  name: "minimap",
+  label: "labels.minimap",
+  viewMode: true,
+  trackEvent: {
+    category: "canvas",
+    predicate: (appState) => !appState.minimapEnabled,
+  },
+  perform(elements, appState) {
+    return {
+      appState: {
+        ...appState,
+        minimapEnabled: !this.checked!(appState),
+      },
+      captureUpdate: CaptureUpdateAction.NEVER,
+    };
+  },
+  checked: (appState) => appState.minimapEnabled,
+  keyTest: (event) =>
+    !event[KEYS.CTRL_OR_CMD] && event.altKey && event.code === CODES.M,
+});
