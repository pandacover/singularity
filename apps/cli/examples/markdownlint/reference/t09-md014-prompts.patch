+++ b/test/commands-show-output-prompts.md
@@ -0,0 +1,35 @@
+# Commands Show Output Prompts
+
+```sh
+$ ls {MD014}
+% pwd {MD014}
+> dir {MD014}
+```
+
+```sh
+%  make {MD014}
+
+PS> Get-ChildItem {MD014}
+```
+
+```sh
+% ls
+file.txt
+```
+
+```sh
+%ls
+```
+
+```sh
+# not a prompt
+```
+
+    > indented {MD014}
+
+<!-- markdownlint-configure-file {
+  "code-block-style": false,
+  "commands-show-output": {
+    "prompts": [ "$", "%", ">", "PS>" ]
+  }
+} -->
