diff --git a/lib/md066.mjs b/lib/md066.mjs
new file mode 100644
index 00000000..c774c52a
--- /dev/null
+++ b/lib/md066.mjs
@@ -0,0 +1,20 @@
+// @ts-check
+
+import { addErrorContext } from "../helpers/helpers.cjs";
+import { getDescendantsByType } from "../helpers/micromark-helpers.cjs";
+import { filterByTypesCached } from "./cache.mjs";
+
+/** @type {import("markdownlint").Rule} */
+export default {
+  "names": [ "MD066", "no-empty-headings" ],
+  "description": "Headings should not be empty",
+  "tags": [ "headings" ],
+  "parser": "micromark",
+  "function": function MD066(params, onError) {
+    for (const heading of filterByTypesCached([ "atxHeading" ])) {
+      if (getDescendantsByType(heading, [ "atxHeadingText" ]).length === 0) {
+        addErrorContext(onError, heading.startLine, heading.text);
+      }
+    }
+  }
+};
