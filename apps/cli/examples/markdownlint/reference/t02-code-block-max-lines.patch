diff --git a/lib/md062.mjs b/lib/md062.mjs
new file mode 100644
index 00000000..8d59eb3b
--- /dev/null
+++ b/lib/md062.mjs
@@ -0,0 +1,54 @@
+// @ts-check
+
+import { addErrorDetailIf } from "../helpers/helpers.cjs";
+import { getDescendantsByType } from "../helpers/micromark-helpers.cjs";
+import { filterByTypesCached } from "./cache.mjs";
+
+/**
+ * Gets the last line of a token that holds any of its content.
+ *
+ * @param {import("markdownlint").MicromarkToken} token Micromark token.
+ * @returns {number} Line number.
+ */
+const lastLineOf = (token) => ((token.endColumn === 1) ? token.endLine - 1 : token.endLine);
+
+/** @type {import("markdownlint").Rule} */
+export default {
+  "names": [ "MD062", "code-block-max-lines" ],
+  "description": "Code blocks should not exceed the maximum number of lines",
+  "tags": [ "code" ],
+  "parser": "micromark",
+  "function": function MD062(params, onError) {
+    const maximum = Number(params.config.maximum || 0);
+    const ignoreLanguages = new Set(
+      (Array.isArray(params.config.ignore_languages) ? params.config.ignore_languages : [])
+        .map((language) => String(language).toLowerCase())
+    );
+    if (maximum > 0) {
+      for (const codeBlock of filterByTypesCached([ "codeFenced", "codeIndented" ])) {
+        let length = 0;
+        if (codeBlock.type === "codeFenced") {
+          const [ openingFence, closingFence ] =
+            codeBlock.children.filter((child) => child.type === "codeFencedFence");
+          const language = getDescendantsByType(openingFence, [ "codeFencedFenceInfo" ])[0]?.text;
+          if (language && ignoreLanguages.has(language.toLowerCase())) {
+            // eslint-disable-next-line no-continue
+            continue;
+          }
+          const lastLine = closingFence ? closingFence.startLine - 1 : lastLineOf(codeBlock);
+          length = lastLine - openingFence.startLine;
+        } else {
+          length = lastLineOf(codeBlock) - codeBlock.startLine + 1;
+        }
+        if (length > maximum) {
+          addErrorDetailIf(
+            onError,
+            codeBlock.startLine,
+            maximum,
+            length
+          );
+        }
+      }
+    }
+  }
+};
