diff --git a/lib/md065.mjs b/lib/md065.mjs
new file mode 100644
index 00000000..157138ac
--- /dev/null
+++ b/lib/md065.mjs
@@ -0,0 +1,44 @@
+// @ts-check
+
+import { addErrorDetailIf } from "../helpers/helpers.cjs";
+import { getDescendantsByType } from "../helpers/micromark-helpers.cjs";
+import { filterByTypesCached } from "./cache.mjs";
+
+const delimiterToStyle = (/** @type {string} */ delimiter) => ((delimiter === ")") ? "parenthesis" : "period");
+const styleToDelimiter = (/** @type {string} */ style) => ((style === "parenthesis") ? ")" : ".");
+
+/** @type {import("markdownlint").Rule} */
+export default {
+  "names": [ "MD065", "ol-delimiter-style" ],
+  "description": "Ordered list delimiter style",
+  "tags": [ "ol" ],
+  "parser": "micromark",
+  "function": function MD065(params, onError) {
+    const style = String(params.config.style || "consistent");
+    let expectedStyle = ((style === "period") || (style === "parenthesis")) ? style : "consistent";
+    for (const listOrdered of filterByTypesCached([ "listOrdered" ])) {
+      const listItemMarkers = getDescendantsByType(listOrdered, [ "listItemPrefix", "listItemMarker" ]);
+      for (const listItemMarker of listItemMarkers) {
+        const actualStyle = delimiterToStyle(listItemMarker.text);
+        if (expectedStyle === "consistent") {
+          expectedStyle = actualStyle;
+        }
+        const column = listItemMarker.startColumn;
+        addErrorDetailIf(
+          onError,
+          listItemMarker.startLine,
+          expectedStyle,
+          actualStyle,
+          undefined,
+          undefined,
+          [ column, 1 ],
+          {
+            "editColumn": column,
+            "deleteCount": 1,
+            "insertText": styleToDelimiter(expectedStyle)
+          }
+        );
+      }
+    }
+  }
+};
