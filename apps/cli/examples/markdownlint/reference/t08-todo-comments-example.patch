diff --git a/test/rules/todo-comments.cjs b/test/rules/todo-comments.cjs
new file mode 100644
index 00000000..172b89a8
--- /dev/null
+++ b/test/rules/todo-comments.cjs
@@ -0,0 +1,25 @@
+// @ts-check
+
+"use strict";
+
+const todoFixmeRe = /\b(?:TODO|FIXME)\b/;
+
+/** @type {import("markdownlint").Rule} */
+module.exports = {
+  "names": [ "todo-comments" ],
+  "description": "Rule that reports TODO and FIXME notes",
+  "tags": [ "test" ],
+  "parser": "none",
+  "function": (params, onError) => {
+    for (const [ index, line ] of params.lines.entries()) {
+      const match = todoFixmeRe.exec(line);
+      if (match) {
+        onError({
+          "lineNumber": index + 1,
+          "detail": "Found " + match[0],
+          "range": [ match.index + 1, match[0].length ]
+        });
+      }
+    }
+  }
+};
