diff --git a/lib/md063.mjs b/lib/md063.mjs
new file mode 100644
index 00000000..9e14d7a6
--- /dev/null
+++ b/lib/md063.mjs
@@ -0,0 +1,38 @@
+// @ts-check
+
+import { addErrorDetailIf } from "../helpers/helpers.cjs";
+import { getParentOfType } from "../helpers/micromark-helpers.cjs";
+import { filterByTypesCached } from "./cache.mjs";
+
+/** @type {import("micromark-util-types").TokenType[]} */
+const listTypes = [ "listOrdered", "listUnordered" ];
+
+/** @type {import("markdownlint").Rule} */
+export default {
+  "names": [ "MD063", "list-max-depth" ],
+  "description": "Lists should not be nested deeper than the maximum",
+  "tags": [ "bullet", "ol", "ul" ],
+  "parser": "micromark",
+  "function": function MD063(params, onError) {
+    const maximum = Number(params.config.maximum || 0);
+    if (maximum > 0) {
+      for (const list of filterByTypesCached(listTypes)) {
+        let depth = 1;
+        /** @type {import("markdownlint").MicromarkToken | null} */
+        let current = list;
+        // @ts-ignore
+        while ((current = getParentOfType(current, listTypes))) {
+          depth++;
+        }
+        if (depth > maximum) {
+          addErrorDetailIf(
+            onError,
+            list.startLine,
+            maximum,
+            depth
+          );
+        }
+      }
+    }
+  }
+};
