diff --git a/lib/md064.mjs b/lib/md064.mjs
new file mode 100644
index 00000000..daf3f4ed
--- /dev/null
+++ b/lib/md064.mjs
@@ -0,0 +1,34 @@
+// @ts-check
+
+import { addErrorContext } from "../helpers/helpers.cjs";
+import { filterByTypesCached } from "./cache.mjs";
+
+const schemeRe = /^([a-z][a-z\d+.-]*):/i;
+
+/** @type {import("markdownlint").Rule} */
+export default {
+  "names": [ "MD064", "link-url-scheme" ],
+  "description": "Link URL scheme should be allowed",
+  "tags": [ "links", "url" ],
+  "parser": "micromark",
+  "function": function MD064(params, onError) {
+    const allowedSchemes = new Set(
+      (Array.isArray(params.config.allowed_schemes) ? params.config.allowed_schemes : [])
+        .map((scheme) => String(scheme).toLowerCase())
+    );
+    if (allowedSchemes.size > 0) {
+      const destinations = filterByTypesCached([
+        "autolinkProtocol",
+        "definitionDestinationString",
+        "resourceDestinationString"
+      ]);
+      for (const destination of destinations) {
+        const { startLine, text } = destination;
+        const match = schemeRe.exec(text);
+        if (match && !allowedSchemes.has(match[1].toLowerCase())) {
+          addErrorContext(onError, startLine, text);
+        }
+      }
+    }
+  }
+};
